[Unit]
Description=Raudhatul Athfal Al-Islam School Website
Documentation=https://github.com/bayu-s-aziz/Raudhatul-Athfal-Web
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=YOUR_USER
Group=YOUR_USER
WorkingDirectory=/home/YOUR_USER/web/YOUR_DOMAIN/private/app
Environment="NODE_ENV=production"
EnvironmentFile=/home/YOUR_USER/web/YOUR_DOMAIN/private/app/.env
ExecStart=/usr/bin/node /home/YOUR_USER/web/YOUR_DOMAIN/private/app/dist/index.cjs
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ra-school

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/home/YOUR_USER/web/YOUR_DOMAIN/private/app

[Install]
WantedBy=multi-user.target
